# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:postgresql://localhost:5432/coffee_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=1209600000

# Toss Payments - Payment Widget / Payment Window
# Frontend uses client key. Backend uses secret key only.
TOSS_WIDGET_CLIENT_KEY=your_toss_widget_client_key
TOSS_WIDGET_SECRET_KEY=your_toss_widget_secret_key

# Optional fallback for non-widget Toss payment window integration
TOSS_CLIENT_KEY=your_toss_client_key
TOSS_SECRET_KEY=your_toss_secret_key

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Delivery
DELIVERY_BASE_FEE=3000
DELIVERY_FREE_THRESHOLD=30000

# Mileage
MILEAGE_REWARD_RATE_PERCENT=1