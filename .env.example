# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Production Docker deployment
APP_IMAGE=ghcr.io/newplayerkor/coffeeprod
APP_IMAGE_TAG=develop
APP_PORT=8080
POSTGRES_DB=coffee_db
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
DEPLOY_WAIT_SECONDS=180

# Database
# 로컬 포트가 사용 중이면 DB_PORT와 DB_URL의 포트를 함께 변경한다.
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/coffee_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=1209600000

# Toss Payments - Payment Widget / Payment Window
# Frontend uses client key. Backend uses secret key only.
TOSS_WIDGET_CLIENT_KEY=your_toss_widget_client_key
TOSS_WIDGET_SECRET_KEY=your_toss_widget_secret_key

# Optional fallback for non-widget Toss payment window integration
TOSS_CLIENT_KEY=your_toss_client_key
TOSS_SECRET_KEY=your_toss_secret_key

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Delivery
DELIVERY_BASE_FEE=3000
DELIVERY_FREE_THRESHOLD=30000

# Mileage
MILEAGE_REWARD_RATE_PERCENT=1

# OAuth: 두 자격 증명이 모두 있을 때만 해당 제공사를 활성화한다.
APP_BACKEND_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
# 카카오 앱에 이메일 동의 권한이 있을 때만 true
OAUTH_KAKAO_EMAIL_SCOPE=false

# 공통 메일 인증: 비밀키는 32자 이상 난수로 별도 생성한다.
AUTH_VERIFICATION_SECRET=
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=CoffeeProd <no-reply@mailsender.ttagyulab.com>

# 회원 전용 AI 추천: 키가 없으면 기존 추천만 제공한다.
AI_PROVIDER=gemini
AI_MODEL=gemini-4-hydrogen
GEMINI_API_KEY=
AI_MONTHLY_BUDGET_USD=8
