BASE_URL=https://api.example.com
PRODUCT_ID=1
TEST_ENV=staging
DB_SNAPSHOT_SHA256=replace-after-snapshot
REQUIRE_RUN_METADATA=false
ALLOW_DIRTY_GIT=false
REQUEST_TIMEOUT=30s

# Catalog image assets (API mapping + R2/CDN delivery)
ASSET_BASE_URL=https://assets-coffeeprod.ttagyulab.com
EXPECTED_PUBLIC_PRODUCT_COUNT=175
EXPECTED_UNIQUE_IMAGE_COUNT=96
IMAGE_API_PAGE_SIZE=200
IMAGE_INVENTORY_BATCH_SIZE=8
IMAGE_RPS=10
IMAGE_DURATION=2m
IMAGE_PRE_ALLOCATED_VUS=20
IMAGE_MAX_VUS=100
IMAGE_FAILURE_RATE=0.01
IMAGE_P95_MS=1000
IMAGE_P99_MS=2000
IMAGE_CACHE_HIT_RATE=0.90

# Provisional quality gates
HTTP_FAILURE_RATE=0.01
HTTP_P95_MS=500
HTTP_P99_MS=1000
CHECK_SUCCESS_RATE=0.99
BUSINESS_ERROR_RATE=0.01
AUTH_ERROR_RATE=0.01
PRODUCT_LIST_P95_MS=500
MEMBER_READ_P95_MS=750
LOGIN_P95_MS=1000

# Deployment-like baseline (20 iterations/s total)
BASELINE_DURATION=5m
BASELINE_PUBLIC_RPS=15
BASELINE_PUBLIC_PRE_ALLOCATED_VUS=30
BASELINE_PUBLIC_MAX_VUS=100
BASELINE_MEMBER_RPS=4
BASELINE_MEMBER_PRE_ALLOCATED_VUS=15
BASELINE_MEMBER_MAX_VUS=60
BASELINE_LOGIN_RPS=1
BASELINE_LOGIN_PRE_ALLOCATED_VUS=5
BASELINE_LOGIN_MAX_VUS=30

# Read load
READ_RPS=10
READ_DURATION=2m
READ_PRE_ALLOCATED_VUS=20
READ_MAX_VUS=100

# Login load
LOGIN_RPS=2
LOGIN_DURATION=2m
LOGIN_PRE_ALLOCATED_VUS=5
LOGIN_MAX_VUS=30

# Stress: ramp and hold at 25, 50, and 100 iterations/s
STRESS_START_RPS=10
STRESS_RPS_1=25
STRESS_RPS_2=50
STRESS_RPS_3=100
STRESS_RAMP_DURATION=2m
STRESS_HOLD_DURATION=3m
STRESS_PRE_ALLOCATED_VUS=50
STRESS_MAX_VUS=300

# Spike: 10 -> 100 -> 10 iterations/s
SPIKE_BASE_RPS=10
SPIKE_PEAK_RPS=100
SPIKE_BASE_DURATION=1m
SPIKE_RAMP_DURATION=10s
SPIKE_PEAK_DURATION=1m
SPIKE_RECOVERY_RAMP_DURATION=10s
SPIKE_RECOVERY_DURATION=2m
SPIKE_PRE_ALLOCATED_VUS=50
SPIKE_MAX_VUS=300

# Soak: use SOAK_DURATION=2h for the final stability run
SOAK_DURATION=30m
SOAK_PUBLIC_RPS=15
SOAK_PUBLIC_PRE_ALLOCATED_VUS=30
SOAK_PUBLIC_MAX_VUS=100
SOAK_MEMBER_RPS=4
SOAK_MEMBER_PRE_ALLOCATED_VUS=15
SOAK_MEMBER_MAX_VUS=60
SOAK_LOGIN_RPS=1
SOAK_LOGIN_PRE_ALLOCATED_VUS=5
SOAK_LOGIN_MAX_VUS=30

# Order concurrency (data-changing test)
ALLOW_WRITES=false
ORDER_VUS=2
ORDER_QUANTITY=1
USED_MILEAGE=0
CANCEL_AFTER=false
